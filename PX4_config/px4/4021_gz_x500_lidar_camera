#!/bin/sh
#
# @name Gazebo X500 with Lidar and Camera - uXRCE-DDS + MAVROS Hybrid
#
# @type Quadrotor
# @class Copter
#

. ${R}etc/init.d/rc.mc_defaults

# Simulator configuration
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_lidar_camera}

# Enable Gazebo simulation
param set-default SIM_GZ_EN 1

# ============================================================================
# SENSOR CONFIGURATION - HYBRID SETUP
# ============================================================================
param set-default SENS_EN_GPSSIM 0     # DISABLE internal GPS - using uXRCE-DDS bridge
param set-default SENS_EN_BAROSIM 1    # Enable barometer simulator
param set-default SENS_EN_MAGSIM 1     # Enable magnetometer simulator

# ============================================================================
# MAGNETOMETER CONFIGURATION
# ============================================================================
param set-default SYS_HAS_MAG 1        # System HAS magnetometer
param set-default CAL_MAG0_ID 1310988  # Magnetometer device ID
param set-default CAL_MAG_PRIME 1310988

# EKF2 magnetometer configuration
param set-default EKF2_MAG_TYPE 0      # Use magnetometer for heading
param set-default EKF2_MAG_CHECK 1     # Enable magnetometer checks
param set-default EKF2_MAG_DECL 12.5   # San Francisco magnetic declination
param set-default EKF2_MAG_NOISE 0.05
param set-default EKF2_MAG_E_NOISE 0.003
param set-default EKF2_MAG_B_NOISE 0.0001

# Arming checks
param set-default COM_ARM_MAG_STR 2
param set-default COM_ARM_MAG_ANG 45

# ============================================================================
# GPS CONFIGURATION - uXRCE-DDS EXTERNAL GPS
# ============================================================================
param set-default SYS_HAS_GPS 1        # System has GPS
param set-default GPS_1_CONFIG 0       # Disable internal GPS driver

# CRITICAL: GPS device ID must match bridge
param set-default GPS_1_PROTOCOL 0     # No internal GPS protocol

# EKF2 GPS configuration - position/velocity/height only
param set-default EKF2_GPS_CTRL 7      # pos(1) + vel(2) + hgt(4) = 7 (NO heading)
param set-default EKF2_HGT_REF 1       # Use GPS for height

# GPS quality thresholds - tuned for uXRCE-DDS bridge
param set-default EKF2_REQ_EPH 8.0     # Horizontal accuracy (8m) - relaxed
param set-default EKF2_REQ_EPV 12.0    # Vertical accuracy (12m) - relaxed
param set-default EKF2_REQ_SACC 2.0    # Speed accuracy (2 m/s)
param set-default EKF2_REQ_NSATS 6     # Required satellites

# GPS processing - optimized for bridge
param set-default EKF2_GPS_CHECK 21    # Basic checks: eph, epv, sacc, nsats
param set-default EKF2_GPS_DELAY 120   # Account for bridge processing delay
param set-default EKF2_GPS_V_NOISE 0.6 # Velocity noise
param set-default EKF2_GPS_P_NOISE 0.8 # Position noise

# GPS position offsets
param set-default EKF2_GPS_POS_X 0.0
param set-default EKF2_GPS_POS_Y 0.0
param set-default EKF2_GPS_POS_Z 0.0

# ============================================================================
# uXRCE-DDS CONFIGURATION
# ============================================================================
# Enable uXRCE-DDS for GPS bridge communication
param set-default UXRCE_DDS_CFG 0      # Ethernet/UDP
param set-default UXRCE_DDS_PRT 8888   # Port 8888 (matches your launch)

# ============================================================================
# MAVLINK CONFIGURATION - FOR MAVROS + QGC
# ============================================================================
# Enable MAVLink on multiple interfaces
param set-default MAV_0_CONFIG 101     # TELEM1 for QGC
param set-default MAV_0_MODE 2         # Onboard mode
param set-default MAV_0_RATE 80000     # High data rate

param set-default MAV_1_CONFIG 102     # TELEM2 for MAVROS
param set-default MAV_1_MODE 2         # Onboard mode
param set-default MAV_1_RATE 80000

# MAVLink system settings
param set-default MAV_SYS_ID 1         # System ID 1 (matches your MAVROS tgt_system: '1')
param set-default MAV_COMP_ID 1

# ============================================================================
# MANUAL CONTROL CONFIGURATION
# ============================================================================
param set-default COM_RC_IN_MODE 1     # No RC mode
param set-default NAV_RCL_ACT 0        # Disable RC loss actions
param set-default COM_RC_LOSS_T 0.5

param set-default COM_RCL_EXCEPT 4
param set-default COM_POSCTL_NAVL 0
param set-default COM_RC_OVERRIDE 0
param set-default COM_RC_ARM_HYST 100
param set-default MAN_ARM_GESTURE 0
param set-default COM_ARM_AUTH_REQ 0
param set-default COM_ARM_AUTH_TO 1
param set-default COM_ARM_AUTO_DISARM 10

# ============================================================================
# EKF2 ESTIMATION - TUNED FOR HYBRID SETUP
# ============================================================================
# Sensor noise parameters
param set-default EKF2_BARO_NOISE 2.0
param set-default EKF2_BARO_DELAY 0
param set-default EKF2_ACC_NOISE 0.35
param set-default EKF2_GYR_NOISE 0.015

# Bias learning - moderate settings
param set-default EKF2_ABL_LIM 1.0
param set-default EKF2_ABL_TAU 1.0
param set-default EKF2_ABL_ACCLIM 25.0
param set-default EKF2_ABL_GYRLIM 3.0

param set-default EKF2_ABIAS_INIT 0.0
param set-default EKF2_GBIAS_INIT 0.0
param set-default EKF2_ACC_B_NOISE 0.01
param set-default EKF2_GYR_B_NOISE 0.0008

# Vertical estimation
param set-default EKF2_VDIST_SENSOR 0
param set-default EKF2_BARO_GATE 5.0

# Innovation checks - relaxed for simulation
param set-default EKF2_REQ_HDRIFT 0.4
param set-default EKF2_REQ_VDRIFT 0.6
param set-default EKF2_CHECK_SCALE 0.7

# Additional settings
param set-default EKF2_NOAID_TOUT 2000000 # 2 second timeout
param set-default EKF2_TERR_MASK 0
param set-default EKF2_RNG_AID 0

# IMU control - use gyro+accel+mag
param set-default EKF2_IMU_CTRL 7

# ============================================================================
# FLIGHT CONTROL PARAMETERS
# ============================================================================
# Altitude control
param set-default MPC_Z_VEL_MAX_DN 2.0
param set-default MPC_Z_VEL_MAX_UP 2.5
param set-default MPC_THR_MAX 0.7
param set-default MPC_THR_MIN 0.12
param set-default MPC_MANTHR_MIN 0.08
param set-default MPC_THR_HOVER 0.55

# Controller gains
param set-default MPC_Z_P 1.0
param set-default MPC_Z_VEL_P_ACC 4.0
param set-default MPC_Z_VEL_I_ACC 2.0
param set-default MPC_Z_VEL_D_ACC 0.0

param set-default MPC_XY_P 0.95
param set-default MPC_XY_VEL_P_ACC 1.8
param set-default MPC_XY_VEL_I_ACC 0.4
param set-default MPC_XY_VEL_D_ACC 0.2

# ============================================================================
# COMMANDER SETTINGS
# ============================================================================
param set-default COM_ARM_WO_GPS 0      # Require GPS for arming
param set-default COM_ARM_EKF_POS 80.0   # Relaxed position accuracy (80m)
param set-default COM_ARM_EKF_VEL 2.0    # Velocity accuracy (2 m/s)
param set-default COM_ARM_EKF_HGT 150.0  # Height accuracy (150m)
param set-default COM_ARM_EKF_YAW 90.0   # Yaw accuracy (90 degrees)

param set-default COM_ARM_IMU_ACC 2.0    # Accelerometer bias limit
param set-default COM_ARM_IMU_GYR 0.8    # Gyroscope bias limit

param set-default COM_DISARM_LAND 2.0
param set-default COM_OF_LOSS_T 1.0
param set-default COM_LOW_BAT_ACT 0

# ============================================================================
# SENSOR CALIBRATION - CONSISTENT DEVICE IDS
# ============================================================================
param set-default SYS_CAL_ACCEL 1
param set-default SYS_CAL_GYRO 1
param set-default SYS_CAL_MAG 1

# CRITICAL: All sensors use same device ID as GPS bridge
param set-default CAL_ACC0_ID 1310988
param set-default CAL_ACC0_XOFF 0.0
param set-default CAL_ACC0_YOFF 0.0
param set-default CAL_ACC0_ZOFF 0.0
param set-default CAL_ACC0_XSCALE 1.0
param set-default CAL_ACC0_YSCALE 1.0
param set-default CAL_ACC0_ZSCALE 1.0
param set-default CAL_ACC_PRIME 1310988

param set-default CAL_GYRO0_ID 1310988
param set-default CAL_GYRO0_XOFF 0.0
param set-default CAL_GYRO0_YOFF 0.0
param set-default CAL_GYRO0_ZOFF 0.0

param set-default CAL_MAG0_XOFF 0.0
param set-default CAL_MAG0_YOFF 0.0
param set-default CAL_MAG0_ZOFF 0.0
param set-default CAL_MAG0_XSCALE 1.0
param set-default CAL_MAG0_YSCALE 1.0
param set-default CAL_MAG0_ZSCALE 1.0

# ============================================================================
# SIMULATION CIRCUIT BREAKERS - USE ONLY IN SIMULATION
# ============================================================================
param set-default CBRK_AIRSPD_CHK 162128
param set-default CBRK_FLIGHTTERM 121212
param set-default COM_ARM_SWISBTN 0

# ============================================================================
# VEHICLE CONFIGURATION
# ============================================================================
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# X500 rotor configuration
param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

# Gazebo motor control
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000