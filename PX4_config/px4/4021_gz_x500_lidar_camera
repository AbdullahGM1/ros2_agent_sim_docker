#!/bin/sh
#
# @name Gazebo X500 with External GPS Bridge - PX4 v1.15 FIXED
#
# @type Quadrotor
# @class Copter
#

. ${R}etc/init.d/rc.mc_defaults

# Simulator configuration
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_lidar_camera}

# Enable Gazebo simulation
param set-default SIM_GZ_EN 1

# ============================================================================
# FIXED SENSOR CONFIGURATION - PX4 v1.15 EXTERNAL GPS COMPATIBLE
# ============================================================================
param set-default SENS_EN_GPSSIM 0     # DISABLE internal GPS (using external bridge)
param set-default SENS_EN_BAROSIM 1    # Enable barometer simulator
param set-default SENS_EN_MAGSIM 0     # DISABLE magnetometer (causes issues with external GPS)

# ============================================================================
# CRITICAL GPS SYSTEM CONFIGURATION - FORCE DEVICE RECOGNITION
# ============================================================================
param set-default SYS_HAS_GPS 1         # CRITICAL: Tell system GPS exists
param set-default GPS_1_CONFIG 0        # Disable internal GPS driver
param set-default GPS_1_GNSS 31         # Enable all GNSS systems

# FORCE EKF2 TO USE SPECIFIC GPS DEVICE
param set-default EKF2_GPS_MASK 3       # Use GPS accuracy metrics
param set-default SENS_GPS_MASK 0       # Use primary GPS only
param set-default EKF2_MULTI_GPS 0      # Single GPS mode
param set-default EKF2_GPS1_POS_X 0.0   # GPS position offset
param set-default EKF2_GPS1_POS_Y 0.0   
param set-default EKF2_GPS1_POS_Z 0.0

# ============================================================================
# EKF2 GPS MESSAGE ROUTING FIX - FORCE GPS ACCEPTANCE
# ============================================================================
# Force EKF2 to accept GPS data regardless of topic routing issues
param set-default EKF2_GPS_CTRL 15      # Enable ALL GPS fusion (pos+vel+hgt+yaw)
param set-default EKF2_HGT_REF 1         # Use GPS for height reference

# BYPASS ALL GPS QUALITY CHECKS - FORCE ACCEPTANCE
param set-default EKF2_GPS_CHECK 0       # Disable ALL GPS checks
param set-default EKF2_REQ_EPH 1000.0    # Accept any horizontal accuracy
param set-default EKF2_REQ_EPV 1000.0    # Accept any vertical accuracy  
param set-default EKF2_REQ_SACC 1000.0   # Accept any speed accuracy
param set-default EKF2_REQ_NSATS 1       # Only need 1 satellite
param set-default EKF2_REQ_PDOP 1000.0   # Accept any PDOP
param set-default EKF2_REQ_HDRIFT 1000.0 # Accept any horizontal drift
param set-default EKF2_REQ_VDRIFT 1000.0 # Accept any vertical drift
param set-default EKF2_REQ_GPS_H 0.1     # Require GPS for only 0.1 seconds

# GPS MESSAGE ACCEPTANCE - FORCE EKF2 TO USE GPS
param set-default EKF2_GPS_DELAY 0       # No GPS delay
param set-default EKF2_GPS_V_NOISE 100.0 # Accept very noisy velocity
param set-default EKF2_GPS_P_NOISE 100.0 # Accept very noisy position
param set-default EKF2_GPS_GATE 1000.0   # Very loose GPS innovation gate

# FORCE GPS DEVICE ACCEPTANCE
param set-default EKF2_MULTI_GPS 0       # Single GPS mode
param set-default SENS_GPS_MASK 0        # Use primary GPS only

# ============================================================================
# MAGNETOMETER BYPASS - REQUIRED FOR v1.15 EXTERNAL GPS
# ============================================================================
param set-default SYS_HAS_MAG 0          # System has NO magnetometer
param set-default EKF2_MAG_TYPE 5        # "None" - disable magnetometer completely
param set-default COM_ARM_MAG_STR 0      # Disable mag strength check
param set-default COM_ARM_MAG_ANG 180    # Allow any mag angle error

# ============================================================================
# IMU CONFIGURATION - EMERGENCY CALIBRATION BYPASS
# ============================================================================
param set-default COM_ARM_IMU_ACC 5.0    # Very relaxed accelerometer bias limit
param set-default COM_ARM_IMU_GYR 2.0    # Very relaxed gyroscope bias limit
param set-default SYS_CAL_ACCEL 1        # Mark accelerometer as calibrated
param set-default SYS_CAL_GYRO 1         # Mark gyroscope as calibrated

# EMERGENCY: Force accelerometer calibration parameters
param set-default CAL_ACC0_ID 1310988    # Simulation accelerometer ID
param set-default CAL_ACC0_XOFF 0.0      # Zero X offset
param set-default CAL_ACC0_YOFF 0.0      # Zero Y offset  
param set-default CAL_ACC0_ZOFF 0.0      # Zero Z offset
param set-default CAL_ACC0_XSCALE 1.0    # Unity X scale
param set-default CAL_ACC0_YSCALE 1.0    # Unity Y scale
param set-default CAL_ACC0_ZSCALE 1.0    # Unity Z scale
param set-default CAL_ACC_PRIME 1310988  # Primary accelerometer

# EMERGENCY: Circuit breaker to bypass accelerometer checks if needed
param set-default CBRK_ACCEL_CHK 894281  # Bypass accelerometer checks

# ============================================================================
# MANUAL CONTROL FIX - NO RC REQUIRED FOR SIMULATION
# ============================================================================
param set-default COM_RC_IN_MODE 1       # Joystick/No RC mode
param set-default NAV_RCL_ACT 0           # Disable RC loss actions
param set-default COM_RC_LOSS_T 0.5       # RC loss timeout
param set-default MAN_ARM_GESTURE 0       # Disable arm gesture requirement
param set-default COM_ARM_SWISBTN 0       # Disable safety switch

# ============================================================================
# ARMING CONFIGURATION - FIXED FOR EXTERNAL GPS
# ============================================================================
param set-default COM_ARM_WO_GPS 0        # REQUIRE GPS for arming (but will use external)
param set-default COM_ARM_EKF_POS 10.0    # Relaxed EKF position accuracy (10m)
param set-default COM_ARM_EKF_VEL 5.0     # Relaxed EKF velocity accuracy (5m/s)
param set-default COM_ARM_EKF_HGT 100.0   # Very relaxed height accuracy
param set-default COM_ARM_EKF_YAW 100.0   # Very relaxed yaw accuracy

# ============================================================================
# EKF2 SENSOR FUSION - OPTIMIZED FOR EXTERNAL GPS + NO MAG
# ============================================================================
param set-default EKF2_IMU_CTRL 7        # Use gyro+accel only (no mag)
param set-default EKF2_BARO_NOISE 2.0    # Barometer noise
param set-default EKF2_ACC_NOISE 0.35    # Accelerometer noise  
param set-default EKF2_GYR_NOISE 0.015   # Gyroscope noise

# Height reference configuration
param set-default EKF2_VDIST_SENSOR 1    # Use GPS for vertical distance
param set-default EKF2_BARO_GATE 5.0     # Barometer innovation gate

# ============================================================================
# VEHICLE CONFIGURATION - STANDARD X500
# ============================================================================
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Rotor configuration - X500 geometry
param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

# Gazebo motor control functions
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

# Motor control limits
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# Hover throttle
param set-default MPC_THR_HOVER 0.60