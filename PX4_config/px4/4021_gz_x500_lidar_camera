#!/bin/sh
#
# @name Gazebo X500 with Lidar and Camera - PX4 1.15 Compatible - COMPASS FIXED
#
# @type Quadrotor
# @class Copter
#

. ${R}etc/init.d/rc.mc_defaults

# Simulator configuration
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_lidar_camera}

# Enable Gazebo simulation
param set-default SIM_GZ_EN 1

# ============================================================================
# SENSOR CONFIGURATION - PX4 v1.15 COMPATIBLE
# ============================================================================
param set-default SENS_EN_GPSSIM 0     # Use external GPS via bridge
param set-default SENS_EN_BAROSIM 1    # Enable barometer simulator
param set-default SENS_EN_MAGSIM 0     # DISABLE broken magnetometer simulator

# ============================================================================
# COMPASS/MAGNETOMETER COMPLETE FIX - PX4 v1.15
# ============================================================================
# CRITICAL: Tell PX4 system has no magnetometer
param set-default SYS_HAS_MAG 0         # System does NOT have magnetometer - FIXES HEALTH CHECK

# Arming checks - disable magnetometer requirements
param set-default COM_ARM_MAG_STR 0     # Disable magnetometer strength check
param set-default COM_ARM_MAG_ANG 180   # Allow any magnetometer angle error

# EKF2 magnetometer configuration - COMPLETE BYPASS
param set-default EKF2_MAG_CHECK 0      # Disable EKF2 magnetometer consistency check
param set-default EKF2_MAG_TYPE 5       # "None" - completely disable magnetometer use
param set-default EKF2_MAG_DECL 0       # Magnetic declination 
param set-default EKF2_MAG_NOISE 0.05   # Magnetometer noise
param set-default EKF2_MAG_E_NOISE 0.05 # Earth magnetic field noise
param set-default EKF2_MAG_B_NOISE 0.05 # Body magnetic field noise

# ============================================================================
# GPS CONFIGURATION - PX4 v1.15 COMPATIBLE
# ============================================================================
# CRITICAL: Use GPS for position AND heading via EKF2_GPS_CTRL
param set-default EKF2_GPS_CTRL 15      # GPS pos(1) + vel(2) + hgt(4) + yaw(8) = 15
param set-default EKF2_HGT_REF 1         # Use GPS for height reference

# GPS Quality Thresholds - RELAXED FOR SIMULATION
param set-default EKF2_REQ_EPH 8.0       # Required horizontal accuracy (8m)
param set-default EKF2_REQ_EPV 12.0      # Required vertical accuracy (12m)
param set-default EKF2_REQ_SACC 2.0      # Required speed accuracy (2 m/s)
param set-default EKF2_REQ_NSATS 6       # Required satellites (6 instead of 10)

# GPS Processing Configuration
param set-default EKF2_GPS_CHECK 245     # GPS check mask (less strict)
param set-default EKF2_GPS_DELAY 110     # GPS measurement delay (110ms)
param set-default EKF2_GPS_V_NOISE 0.5   # GPS velocity noise (0.5 m/s)
param set-default EKF2_GPS_P_NOISE 0.5   # GPS position noise (0.5 m)

# EKF2 GPS Position Settings
param set-default EKF2_GPS_POS_X 0.0    # GPS antenna position offset
param set-default EKF2_GPS_POS_Y 0.0       
param set-default EKF2_GPS_POS_Z 0.0       

# Commander Settings - RELAXED FOR SIMULATION
param set-default COM_ARM_WO_GPS 1       # Allow arming without GPS
param set-default COM_ARM_EKF_POS 0.5    # Relaxed EKF position accuracy for arming
param set-default COM_ARM_EKF_VEL 1.0    # Relaxed EKF velocity accuracy for arming

# Position Control Tuning - SMOOTHER CONTROL
param set-default MPC_XY_P 1.0           # Position controller P gain
param set-default MPC_Z_P 1.0            # Altitude controller P gain
param set-default MPC_XY_VEL_P_ACC 1.5   # Velocity controller P gain
param set-default MPC_XY_VEL_I_ACC 0.3   # Velocity controller I gain
param set-default MPC_XY_VEL_D_ACC 0.15  # Velocity controller D gain

# ============================================================================
# VEHICLE CONFIGURATION
# ============================================================================

# Vehicle type
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Rotor configuration (X500 geometry)
param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

# Gazebo motor control functions
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

# Motor control limits
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# Hover throttle
param set-default MPC_THR_HOVER 0.60