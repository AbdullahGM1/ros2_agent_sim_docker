# ============================================================================
# ROS2 Jazzy + Gazebo Harmonic + PX4 + MAVROS + ROSA + AI/ML
# ============================================================================

FROM osrf/ros:jazzy-desktop

LABEL maintainer="AbdullahGM1 <agm.musalami@gmail.com>"
LABEL description="ROS2 Jazzy + Gazebo Harmonic + PX4 + MAVROS + ROSA + AI/ML Stack"

# ============================================================================
# PHASE 1: Environment Setup 
# ============================================================================
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=jazzy
ENV GZ_VERSION=harmonic
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# GPU and Graphics Environment Variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_INDIRECT=0
ENV DISPLAY=:0

# Development Environment Variables
ENV DEV_DIR=/home/user/shared_volume
ENV PX4_DIR=$DEV_DIR/PX4-Autopilot
ENV ROS2_WS=$DEV_DIR/ros2_ws
ENV OSQP_SRC=$DEV_DIR
ENV ROS_DOMAIN_ID=0
ENV JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF8

# PX4 NuttX toolchain environment variables
ENV NUTTX_GCC_VERSION="10.3-2021.10"
ENV NUTTX_GCC_VERSION_SHORT="10.3-2021q4"
ENV INSTALL_ARCH="x86_64"
ENV PATH="/opt/gcc-arm-none-eabi-${NUTTX_GCC_VERSION}/bin:$PATH"

# ============================================================================
# PHASE 2: System Packages Installation
# ============================================================================

# Essential system packages and locales
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    software-properties-common \
    locales \
    ca-certificates \
    gnupg \
    lsb-release \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Development tools and build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    ccache \
    git \
    pkg-config \
    make \
    gcc \
    g++ \
    gdb \
    valgrind \
    cppcheck \
    astyle \
    doxygen \
    lcov \
    unzip \
    zip \
    bzip2 \
    rsync \
    shellcheck \
    xsltproc \
    file \
    dirmngr \
    openssh-client \
    bash-completion \
    command-not-found \
    tzdata \
    gosu \
    gedit \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Graphics, GUI, and multimedia support
RUN apt-get update && apt-get install -y --no-install-recommends \
    mesa-utils \
    x11-apps \
    libgl1-mesa-dri \
    libglu1-mesa \
    libegl1 \
    libgles2 \
    libglx-mesa0 \
    libxrender1 \
    libxext6 \
    libx11-6 \
    libxrandr2 \
    libxss1 \
    libxcursor1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxtst6 \
    libnss3 \
    libasound2t64 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PHASE 3: Python Environment Setup 
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-full \
    python3-venv \
    python3-dev \
    python3-setuptools-scm \
    cython3 \
    libpython3-dev \
    python3-vcstool \
    python3-rosinstall-generator \
    python3-osrf-pycommon \
    && rm -rf /var/lib/apt/lists/*

# Create Python virtual environment to solve PEP 668 issues
RUN python3 -m venv /opt/python-env
ENV PATH="/opt/python-env/bin:$PATH"
ENV VIRTUAL_ENV="/opt/python-env"

# Install pip and core Python packages 
RUN pip install --upgrade pip setuptools wheel cython

# ============================================================================
# PHASE 4: Add External Repositories
# ============================================================================

# Add Gazebo Harmonic repository
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null

# Add VS Code repository
RUN wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > packages.microsoft.gpg && \
    install -D -o root -g root -m 644 packages.microsoft.gpg /etc/apt/keyrings/packages.microsoft.gpg && \
    sh -c 'echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list' && \
    rm -f packages.microsoft.gpg

# ============================================================================
# PHASE 5: Gazebo Harmonic Installation
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    gz-harmonic \
    gz-sim8-cli \
    libgz-transport13-dev \
    libgz-math8-dev \
    libgz-cmake3-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PHASE 6: ROS2 Jazzy Additional Packages
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros-gz-interfaces \
    ros-jazzy-gz-ros2-control \
    ros-jazzy-gz-ros2-control-demos \
    ros-jazzy-mavros \
    ros-jazzy-mavros-extras \
    ros-jazzy-xacro \
    ros-jazzy-robot-localization \
    ros-jazzy-ros2-controllers \
    ros-jazzy-ros2-control \
    ros-jazzy-velodyne \
    ros-jazzy-velodyne-description \
    ros-jazzy-tf2-eigen \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-eigen3-cmake-module \
    ros-jazzy-geographic-msgs \
    ros-jazzy-eigen-stl-containers \
    ros-jazzy-diagnostic-updater \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PHASE 7: MAVROS Dependencies and GeographicLib Data
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    geographiclib-tools \
    libgeographiclib-dev \
    libasio-dev \
    libgoogle-glog-dev \
    libconsole-bridge-dev \
    libtinyxml2-dev \
    libpoco-dev \
    libxml2-dev \
    libxml2-utils \
    libxslt1-dev \
    libboost-all-dev \
    libeigen3-dev \
    libfuse2t64 \
    libimage-exiftool-perl \
    libopencv-dev \
    protobuf-compiler \
    dmidecode \
    && rm -rf /var/lib/apt/lists/*

# Install geographiclib datasets
RUN geographiclib-get-geoids egm96-5 && \
    geographiclib-get-gravity egm96 && \
    geographiclib-get-magnetic emm2015

# ============================================================================
# PHASE 8: XRCE-DDS Agent Installation
# ============================================================================
RUN git clone https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/Micro-XRCE-DDS-Agent && \
    cd /tmp/Micro-XRCE-DDS-Agent && \
    mkdir build && cd build && \
    cmake .. && make -j$(nproc) && make install && \
    ldconfig /usr/local/lib/ && \
    rm -rf /tmp/Micro-XRCE-DDS-Agent

# ============================================================================
# PHASE 9: JSBSim Installation
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends libsubunit-dev && \
    rm -rf /var/lib/apt/lists/* && \
    wget https://github.com/JSBSim-Team/jsbsim/archive/refs/tags/v1.1.14.tar.gz -O /tmp/jsbsim.tar.gz && \
    cd /tmp && tar -xzf jsbsim.tar.gz && cd jsbsim-1.1.14 && \
    mkdir build && cd build && \
    cmake .. && make -j$(nproc) && make install && \
    rm -rf /tmp/jsbsim*

# ============================================================================
# PHASE 10: VS Code Installation
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    code \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PHASE 11: NuttX Toolchain and Java 
# ============================================================================

# NuttX toolchain dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    automake \
    binutils-dev \
    bison \
    flex \
    g++-multilib \
    gcc-multilib \
    gdb-multiarch \
    genromfs \
    gettext \
    gperf \
    libelf-dev \
    libexpat-dev \
    libgmp-dev \
    libisl-dev \
    libmpc-dev \
    libmpfr-dev \
    libncurses6 \
    libncurses-dev \
    libtool \
    screen \
    texinfo \
    u-boot-tools \
    util-linux \
    vim-common \
    kconfig-frontends \
    && rm -rf /var/lib/apt/lists/*

# FIXED: Install ARM GCC toolchain using multiple fallback methods
RUN set -e && \
    echo "Installing ARM GCC toolchain..." && \
    # Method 1: Try the official ARM release 
    (wget -O /tmp/gcc-arm-none-eabi.tar.bz2 \
        "https://developer.arm.com/-/media/Files/downloads/gnu-rm/10.3-2021.10/gcc-arm-none-eabi-10.3-2021.10-x86_64-linux.tar.bz2" && \
     tar -jxf /tmp/gcc-arm-none-eabi.tar.bz2 -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.bz2 && \
     echo "✅ ARM GCC installed from official ARM site") || \
    # Method 2: Try alternative mirror
    (wget -O /tmp/gcc-arm-none-eabi.tar.bz2 \
        "https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-rm/10.3-2021.07/gcc-arm-none-eabi-10.3-2021.07-x86_64-linux.tar.bz2" && \
     tar -jxf /tmp/gcc-arm-none-eabi.tar.bz2 -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.bz2 && \
     echo "✅ ARM GCC installed from alternative mirror") || \
    # Method 3: Use system package manager as fallback
    (apt-get update && \
     apt-get install -y --no-install-recommends gcc-arm-none-eabi && \
     rm -rf /var/lib/apt/lists/* && \
     echo "✅ ARM GCC installed from system packages") || \
    # Method 4: Download from GitHub releases
    (wget -O /tmp/gcc-arm-none-eabi.tar.bz2 \
        "https://github.com/xpack-dev-tools/arm-none-eabi-gcc-xpack/releases/download/v10.3.1-2.3/xpack-arm-none-eabi-gcc-10.3.1-2.3-linux-x64.tar.gz" && \
     tar -zxf /tmp/gcc-arm-none-eabi.tar.bz2 -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.bz2 && \
     echo "✅ ARM GCC installed from GitHub releases") || \
    # If all methods fail, show error
    (echo "❌ All ARM GCC installation methods failed" && exit 1)

# Update PATH to include ARM GCC 
ENV PATH="/opt/gcc-arm-none-eabi-10.3-2021.10/bin:/opt/gcc-arm-none-eabi-10.3-2021.07/bin:/opt/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin:$PATH"

# Java installation for jMAVSim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ant \
    openjdk-21-jre \
    openjdk-21-jdk \
    libvecmath-java \
    && rm -rf /var/lib/apt/lists/*

# Set Java as default
RUN update-alternatives --set java $(update-alternatives --list java | grep "java-21") || echo "Java alternatives setting skipped"
# ============================================================================
# PHASE 12: User Setup 
# ============================================================================

# Create user with proper permissions
RUN if id -u 1000 >/dev/null 2>&1; then \
        EXISTING_USER=$(id -nu 1000) && \
        if [ "$EXISTING_USER" != "user" ]; then \
            userdel -r $EXISTING_USER 2>/dev/null || true; \
        fi; \
    fi && \
    if ! id user >/dev/null 2>&1; then \
        useradd --shell /bin/bash -u 1000 -c "" -m user; \
    fi && \
    usermod -a -G dialout user && \
    echo "user:user" | chpasswd && \
    adduser user sudo && \
    echo "user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/user && \
    chmod 0440 /etc/sudoers.d/user

# ============================================================================
# PHASE 13: Python Dependencies 
# ============================================================================

# All Python packages in one consolidated installation
RUN pip install --no-cache-dir \
    "numpy>=1.21.0,<2.0.0" \
    "PyYAML==6.0.1" \
    future \
    rospkg \
    rich \
    argcomplete \
    "argparse>=1.2" \
    cerberus \
    coverage \
    "empy>=3.3,<4.0" \
    "jinja2>=2.8" \
    jsonschema \
    kconfiglib \
    lxml \
    "matplotlib>=3.0.0,<4.0.0" \
    "nunavut>=1.1.0" \
    packaging \
    "pandas>=0.21,<3.0.0" \
    pkgconfig \
    psutil \
    pygments \
    "wheel>=0.31.1" \
    pymavlink \
    pyros-genmsg \
    pyserial \
    "pyulog>=0.5.0" \
    requests \
    "setuptools>=39.2.0" \
    "six>=1.12.0" \
    "toml>=0.9" \
    "sympy>=1.10.1" \
    "typing-extensions>=4.7.0" \
    "symforce>=0.10.0,<0.11.0" \
    langchain \
    langchain-ollama \
    "langchain-community==0.3.21" \
    ollama \
    jpl-rosa \
    "opencv-python>=4.5.0,<5.0.0"

# ============================================================================
# PHASE 14: Ollama Installation + LLM Models
# ============================================================================
RUN curl -fsSL https://ollama.com/install.sh | sh

# LLM Model Installation (commented for build speed - can be enabled if needed)
# Note: These models are large (4-8GB each) and significantly increase build time
# Uncomment the models you want pre-installed, or pull them at runtime instead

# Start Ollama service temporarily for model downloads (if uncommenting models below)
# RUN ollama serve &

# Wait for Ollama service to start
# RUN sleep 5

# Download Qwen models (recommended for ROS2 Agent)
# RUN ollama pull qwen2.5:8b     # Main model mentioned in README (8B parameters)
# RUN ollama pull qwen2.5:3b     # Lighter alternative (3B parameters)
# RUN ollama pull qwen2.5:1.5b   # Smallest option (1.5B parameters)

# Download alternative models (optional)
# RUN ollama pull llama3.2:3b    # Meta's Llama 3.2 (3B parameters) 
# RUN ollama pull phi3.5:3.8b    # Microsoft Phi-3.5 (3.8B parameters)
# RUN ollama pull mistral:7b     # Mistral AI model (7B parameters)

# Stop Ollama service after model downloads
# RUN pkill ollama || true

# Runtime model pulling (recommended approach):
# Users can pull models when needed using:
# docker exec -it ros2_agent_sim ollama pull qwen2.5:8b

# ============================================================================
# PHASE 15: VMWare Graphics Fix and Verification
# ============================================================================

# VMWare 3D graphics acceleration for gazebo
RUN if dmidecode -t system 2>/dev/null | grep -q "Manufacturer: VMware, Inc." ; then \
        echo "export SVGA_VGPU10=0" >> /etc/environment ; \
        echo "VMWare detected - applied graphics fix" ; \
    else \
        echo "Non-VMWare environment detected" ; \
    fi

# Environment verification
RUN echo "=== PX4 Development Environment Verification ===" && \
    echo "Ubuntu Version: $(lsb_release -rs)" && \
    echo "GCC Version: $(gcc --version | head -1)" && \
    echo "CMake Version: $(cmake --version | head -1)" && \
    echo "Python Version: $(python3 --version)" && \
    echo "Java Version: $(java -version 2>&1 | head -1)" && \
    echo "NuttX GCC: $(arm-none-eabi-gcc --version | head -1)" && \
    echo "Gazebo Version: $(gz sim --version 2>/dev/null | head -1)" && \
    echo "Python packages verification:" && \
    python3 -c "import pymavlink; print('✅ pymavlink installed')" && \
    python3 -c "import jinja2; print('✅ jinja2 installed')" && \
    python3 -c "import yaml; print('✅ PyYAML installed')" && \
    python3 -c "import kconfiglib; print('✅ kconfiglib installed')" && \
    echo "=== Verification Complete ==="

# ============================================================================
# PHASE 16: Configuration Files and Templates
# ============================================================================

# Create configuration directories
RUN mkdir -p /opt/bashrc_templates /usr/local/share/middleware_profiles

# Copy configuration files
COPY middleware_profiles/*profile.xml /usr/local/share/middleware_profiles/
COPY scripts/bashrc_template.sh /opt/bashrc_templates/bashrc_template.sh


# ============================================================================
# PHASE 16.5: Pre-clone Repositories 
# ============================================================================

# Create workspace structure in container  
RUN mkdir -p /home/user/ros2_ws/src

# Clone ros2_agent_sim with submodules 
RUN cd /home/user/ros2_ws/src && \
    git clone --recursive https://github.com/AbdullahGM1/ros2_agent_sim.git && \
    cd ros2_agent_sim && \
    git submodule update --init --recursive

# Clone PX4-Autopilot 
RUN git clone https://github.com/AbdullahGM1/PX4-Autopilot.git /tmp/PX4-Autopilot && \
    cd /tmp/PX4-Autopilot && \
    git checkout navsat_callback

# Clone MAVLink 
RUN cd /home/user/ros2_ws/src && \
    git clone https://github.com/AbdullahGM1/mavlink-gbp-release.git mavlink && \
    cd mavlink && \
    git checkout release/jazzy/mavlink

# Clone MAVROS  
RUN cd /home/user/ros2_ws/src && \
    git clone https://github.com/AbdullahGM1/mavros.git && \
    cd mavros && \
    git checkout ros2

# gz_sim dependencies in Unitree packages 
RUN if [ -d "/home/user/ros2_ws/src/ros2_agent_sim/unitree_go2_ros2" ]; then \
        find /home/user/ros2_ws/src/ros2_agent_sim/unitree_go2_ros2 -name "package.xml" -exec sed -i '/<.*depend>gz_sim<\/.*depend>/d' {} \; && \
        find /home/user/ros2_ws/src/ros2_agent_sim/unitree_go2_ros2 -name "package.xml" -exec sed -i '/<.*depend>gz-sim<\/.*depend>/d' {} \; ; \
    fi

# Set proper ownership for cloned repositories
RUN chown -R user:user /home/user/ros2_ws /tmp/PX4-Autopilot

# ============================================================================
# PHASE 17: Application Files and Scripts
# ============================================================================

# Create directories and copy application files
RUN mkdir -p /home/user/backup
COPY scripts/install.sh /home/user/backup/
COPY PX4_config /home/user/backup/PX4_config/
RUN chmod +x /home/user/backup/install.sh

# Copy and setup entrypoint
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# ============================================================================
# PHASE 18: Final User Environment Setup
# ============================================================================

# Set ownership for user directories and Python environment
RUN mkdir -p /home/user/shared_volume && \
    chown -R user:user /home/user /opt/python-env && \
    chmod 755 /home/user/shared_volume

# Switch to user and setup environment
USER user
WORKDIR /home/user

# Setup user bashrc with all components
RUN echo "# ROS2 Jazzy + Gazebo Harmonic + AI/ML Environment" >> ~/.bashrc && \
    echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc && \
    echo "export PATH=/opt/python-env/bin:\$PATH" >> ~/.bashrc && \
    echo "export VIRTUAL_ENV=/opt/python-env" >> ~/.bashrc && \
    echo "export GZ_VERSION=harmonic" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=0" >> ~/.bashrc && \
    echo "export DEV_DIR=/home/user/shared_volume" >> ~/.bashrc && \
    echo "export PX4_DIR=\$DEV_DIR/PX4-Autopilot" >> ~/.bashrc && \
    echo "export ROS2_WS=\$DEV_DIR/ros2_ws" >> ~/.bashrc && \
    echo "export OSQP_SRC=\$DEV_DIR" >> ~/.bashrc && \
    echo "# Source workspace if available" >> ~/.bashrc && \
    echo 'if [ -f "$ROS2_WS/install/setup.bash" ]; then source "$ROS2_WS/install/setup.bash"; fi' >> ~/.bashrc

# ============================================================================
# PHASE 19: Health Check and Finalization
# ============================================================================

# Initialize rosdep for user
RUN rosdep update || echo "rosdep update completed"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD bash -c "source ~/.bashrc && ros2 topic list" || exit 1

# Set entrypoint and default command
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]

# ============================================================================
# Build Information
# ============================================================================
LABEL build.optimization="optimized-sequence"
LABEL build.features="ros2-jazzy,gazebo-harmonic,px4,mavros,rosa,ai-ml"
LABEL build.approach="binary-packages-preferred"