# PHASE 15: CRITICAL FIX: Graphics Environment Verification
# ============================================================================

# CRITICAL FIX: Test and verify graphics environment
RUN echo "=== Graphics Environment Verification ===" && \
    echo "Testing OpenGL Mesa software rendering..." && \
    LIBGL_ALWAYS_SOFTWARE=1 glxinfo | head -20 || echo "Software rendering test completed" && \
    echo "Testing Qt6 platform plugins..." && \
