RUN mkdir -p /home/user/shared_volume && \
    chown -R user:user /home/user && \
    chmod 755 /home/user/shared_volume

# Switch to user and setup environment
USER user
WORKDIR /home/user

# CRITICAL FIX: Setup user bashrc with proper Qt6 and graphics environment
