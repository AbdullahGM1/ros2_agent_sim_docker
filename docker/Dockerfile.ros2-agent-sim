# ============================================================================
# PHASE 16: Configuration Files and Templates
# ============================================================================

# Create configuration directories
RUN mkdir -p /opt/bashrc_templates /usr/local/share/middleware_profiles

# Copy configuration files
COPY middleware_profiles/*profile.xml /usr/local/share/middleware_profiles/
COPY scripts/bashrc_template.sh /opt/bashrc_templates/bashrc_template.sh

# ============================================================================
# PHASE 17: Pre-clone Repositories 
# ============================================================================

# Create workspace structure in container  
RUN mkdir -p /home/user/ros2_ws/src

# Create workspace structure in container  
RUN mkdir -p /home/user/ros2_ws/src

# Clone ros2_agent_sim with robust submodule handling
RUN cd /home/user/ros2_ws/src && \
    git clone https://github.com/AbdullahGM1/ros2_agent_sim.git && \
    cd ros2_agent_sim && \
    echo "=== Initializing submodules with error handling ===" && \
    git submodule init && \
    for submodule in $(git submodule status | awk '{print $2}'); do \
        echo "Processing submodule: $submodule"; \
        if git submodule update "$submodule"; then \
            echo "✅ Successfully updated $submodule"; \
        else \
            echo "⚠️ Failed to update $submodule, trying to reset to HEAD"; \
            cd "$submodule" 2>/dev/null && git fetch origin && git reset --hard origin/HEAD && cd .. || \
            echo "❌ Submodule $submodule failed - continuing without it"; \
        fi; \
    done && \
    echo "✅ Submodule initialization completed"

# Clone and build PX4-Autopilot 
RUN echo "=== Setting up PX4-Autopilot with conditional logic ===" && \
    # Define helper functions for consistent output
    print_info() { echo "ℹ️ [INFO] $1"; } && \
    print_status() { echo "✅ [STATUS] $1"; } && \
    print_error() { echo "❌ [ERROR] $1"; } && \
    \
    # Check if PX4_DIR exists and handle accordingly
    if [ ! -d "$PX4_DIR" ]; then \
        print_info "PX4_DIR=$PX4_DIR does not exist, cloning PX4-Autopilot..."; \
        cd $DEV_DIR && \
        if git clone https://github.com/riotu-lab/PX4-Autopilot.git --recursive; then \
            print_status "PX4-Autopilot cloned successfully"; \
        else \
            print_error "Failed to clone PX4-Autopilot"; \
            exit 1; \
        fi && \
        cd $PX4_DIR && \
        print_info "Cleaning PX4 build environment..." && \
        (make submodulesclean || echo "submodulesclean completed with warnings") && \
        (make distclean || echo "distclean completed with warnings") && \
        (make clean || echo "clean completed with warnings") && \
        print_info "Checking out navsat_callback branch..." && \
        if git checkout navsat_callback; then \
            print_status "PX4-Autopilot cloned and configured"; \
        else \
            print_error "Failed to checkout navsat_callback branch"; \
            exit 1; \
        fi; \
    else \
        print_info "PX4_DIR=$PX4_DIR already exists"; \
        cd $PX4_DIR && \
        print_info "Cleaning existing PX4 build environment..." && \
        (make submodulesclean || echo "submodulesclean completed with warnings") && \
        (make distclean || echo "distclean completed with warnings") && \
        (make clean || echo "clean completed with warnings") && \
        print_info "Checking out navsat_callback branch..." && \
        if git checkout navsat_callback; then \
            print_status "PX4-Autopilot cleaned and configured"; \
        else \
            print_error "Failed to checkout navsat_callback branch"; \
            exit 1; \
        fi; \
    fi && \
    \
    # Ensure EmPy version is correct (from original logic)
    print_info "Installing correct EmPy version..." && \
    pip3 install --break-system-packages --force-reinstall "empy>=3.3,<4.0" && \
    print_status "PX4-Autopilot setup completed successfully"

# Clone other repositories
RUN cd /home/user/ros2_ws/src && \
    git clone https://github.com/AbdullahGM1/mavlink-gbp-release.git mavlink && \
    cd mavlink && \
    git checkout release/jazzy/mavlink

RUN cd /home/user/ros2_ws/src && \
    git clone https://github.com/AbdullahGM1/mavros.git && \
    cd mavros && \
    git checkout ros2

# Clone px4_msgs repository 
