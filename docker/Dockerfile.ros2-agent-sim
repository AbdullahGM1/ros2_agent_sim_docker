LABEL maintainer="AbdullahGM1 <agm.musalami@gmail.com>"
LABEL description="ROS2 Jazzy + Gazebo Harmonic + PX4 + MAVROS + ROSA + AI/ML Stack (FIXED)"

# ============================================================================
# PHASE 1: Environment Setup 
# ============================================================================
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=jazzy
ENV GZ_VERSION=harmonic
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ============================================================================
# CRITICAL FIX: Qt6 and Graphics Environment Variables
# ============================================================================
ENV QT_QPA_PLATFORM=xcb
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_INDIRECT=0
ENV LIBGL_ALWAYS_SOFTWARE=0
ENV MESA_GL_VERSION_OVERRIDE=4.5
ENV MESA_GLSL_VERSION_OVERRIDE=450
ENV GALLIUM_DRIVER=llvmpipe
ENV DISPLAY=:0

# GPU and Graphics Environment Variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV XDG_RUNTIME_DIR=/tmp/runtime-user
ENV XDG_SESSION_TYPE=x11

# Development Environment Variables
ENV DEV_DIR=/home/user/shared_volume
ENV PX4_DIR=$DEV_DIR/PX4-Autopilot
ENV ROS2_WS=$DEV_DIR/ros2_ws
ENV OSQP_SRC=$DEV_DIR
ENV ROS_DOMAIN_ID=0
ENV JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF8

# PX4 NuttX toolchain environment variables
ENV NUTTX_GCC_VERSION="10.3-2021.10"
ENV NUTTX_GCC_VERSION_SHORT="10.3-2021q4"
ENV INSTALL_ARCH="x86_64"
ENV PATH="/opt/gcc-arm-none-eabi-${NUTTX_GCC_VERSION}/bin:$PATH"

