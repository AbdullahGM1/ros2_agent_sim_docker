# FIXED: Install ARM GCC toolchain using multiple fallback methods
RUN set -e && \
    echo "Installing ARM GCC toolchain..." && \
    # Method 1: Try the official ARM release 
    (wget -O /tmp/gcc-arm-none-eabi.tar.bz2 \
        "https://developer.arm.com/-/media/Files/downloads/gnu-rm/10.3-2021.10/gcc-arm-none-eabi-10.3-2021.10-x86_64-linux.tar.bz2" && \
     tar -jxf /tmp/gcc-arm-none-eabi.tar.bz2 -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.bz2 && \
     echo "✅ ARM GCC installed from official ARM site") || \
    # Method 2: Try alternative mirror
    (wget -O /tmp/gcc-arm-none-eabi.tar.bz2 \
        "https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-rm/10.3-2021.07/gcc-arm-none-eabi-10.3-2021.07-x86_64-linux.tar.bz2" && \
     tar -jxf /tmp/gcc-arm-none-eabi.tar.bz2 -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.bz2 && \
     echo "✅ ARM GCC installed from alternative mirror") || \
    # Method 3: Use system package manager as fallback
    (apt-get update && \
     apt-get install -y --no-install-recommends gcc-arm-none-eabi && \
     rm -rf /var/lib/apt/lists/* && \
     echo "✅ ARM GCC installed from system packages") || \
    # Method 4: Download from GitHub releases
    (wget -O /tmp/gcc-arm-none-eabi.tar.gz \
        "https://github.com/xpack-dev-tools/arm-none-eabi-gcc-xpack/releases/download/v10.3.1-2.3/xpack-arm-none-eabi-gcc-10.3.1-2.3-linux-x64.tar.gz" && \
     tar -zxf /tmp/gcc-arm-none-eabi.tar.gz -C /opt/ && \
     rm /tmp/gcc-arm-none-eabi.tar.gz && \
     echo "✅ ARM GCC installed from GitHub releases") || \
    # If all methods fail, show error
    (echo "❌ All ARM GCC installation methods failed" && exit 1)

# Update PATH to include ARM GCC 
ENV PATH="/opt/gcc-arm-none-eabi-10.3-2021.10/bin:/opt/gcc-arm-none-eabi-10.3-2021.07/bin:/opt/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin:$PATH"

# Java installation for jMAVSim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ant \
    openjdk-21-jre \
    openjdk-21-jdk \
    libvecmath-java \
    && rm -rf /var/lib/apt/lists/*

# Set Java as default
RUN update-alternatives --set java $(update-alternatives --list java | grep "java-21") || echo "Java alternatives setting skipped"

# ============================================================================
# PHASE 12: User Setup 
# ============================================================================

# Create user with proper permissions
RUN if id -u 1000 >/dev/null 2>&1; then \
        EXISTING_USER=$(id -nu 1000) && \
        if [ "$EXISTING_USER" != "user" ]; then \
            userdel -r $EXISTING_USER 2>/dev/null || true; \
        fi; \
    fi && \
    if ! id user >/dev/null 2>&1; then \
        useradd --shell /bin/bash -u 1000 -c "" -m user; \
    fi && \
    usermod -a -G dialout user && \
    echo "user:user" | chpasswd && \
    adduser user sudo && \
    echo "user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/user && \
    chmod 0440 /etc/sudoers.d/user

